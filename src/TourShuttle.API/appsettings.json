{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "TourShuttle.API",
    "Audience": "TourShuttle.Client",
    "ExpiresMinutes": 60
  },
  "PickupTimeEstimation": {
    "TimeZone": "Asia/Jerusalem",
    "DefaultMinutes": 2,
    "Bands": [
      { "From": "23:00", "To": "07:30", "Minutes": 1 },
      { "From": "14:30", "To": "17:30", "Minutes": 3 }
    ]
  }
}
