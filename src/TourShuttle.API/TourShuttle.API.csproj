<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Points to secrets.json in the user profile; the id itself is not a secret -->
    <UserSecretsId>4c78647e-10f1-49fc-ac9e-328457526f46</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- NLog reads its configuration from the folder the app runs in, locally and in the container. -->
    <Content Update="nlog.config" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TourShuttle.Application\TourShuttle.Application.csproj" />
    <ProjectReference Include="..\TourShuttle.Infrastructure\TourShuttle.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NLog.Web.AspNetCore" Version="6.2.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.0" />
  </ItemGroup>

</Project>
