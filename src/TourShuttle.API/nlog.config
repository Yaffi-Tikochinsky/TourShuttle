<?xml version="1.0" encoding="utf-8" ?>
<!--
  NLog configuration: WHERE log lines go (targets) and WHICH lines go there (rules).
  The code only writes to ILogger<T>; this file decides everything else, and can change without recompiling.
  Levels that differ between environments come from appsettings ("Logs" section):
  appsettings.json for production, appsettings.Development.json for development.
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      throwConfigExceptions="true">

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <!-- date | level | correlation id | source class | message [exception with stack trace] -->
  <variable name="line"
            value="${longdate}|${level:uppercase=true}|${scopeproperty:CorrelationId:whenEmpty=-}|${logger}|${message}${onexception:inner= ${exception:format=tostring}}" />

  <targets>
    <!-- What Render shows on the service's Logs page. -->
    <target xsi:type="Console" name="console" layout="${line}" />

    <!-- One file per day, kept for 7 days so the disk never fills up. -->
    <target xsi:type="File" name="file"
            fileName="${basedir}/logs/tourshuttle-${shortdate}.log"
            layout="${line}"
            maxArchiveDays="7"
            encoding="utf-8" />
  </targets>

  <!-- Checked top to bottom. final="true" stops at the first rule that matches;
       a rule with no writeTo drops the lines it matches. -->
  <rules>
    <!-- Data Protection (cookie encryption keys) warns on every container start; this API uses JWT, not cookies. -->
    <logger name="Microsoft.AspNetCore.DataProtection.*" maxlevel="Warn" final="true" />

    <!-- SQL commands: shown in development (to check for N+1), hidden in production (several lines per request). -->
    <logger name="Microsoft.EntityFrameworkCore.Database.Command"
            minlevel="${configsetting:item=Logs.SqlMinLevel:default=Warn}" writeTo="console,file" final="true" />

    <!-- Startup lines worth keeping: "Applying migration ...", "Now listening on ...", "Application started". -->
    <logger name="Microsoft.EntityFrameworkCore.Migrations" minlevel="Info" writeTo="console,file" final="true" />
    <logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="console,file" final="true" />

    <!-- The rest of the framework: warnings and errors only. -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />

    <!-- Our code: Information in production, Debug (calculation details) in development. -->
    <logger name="*" minlevel="${configsetting:item=Logs.AppMinLevel:default=Info}" writeTo="console,file" />
  </rules>
</nlog>
